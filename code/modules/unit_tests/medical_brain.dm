/// Healing through both public organ APIs must consume phantom damage before real tissue damage.
/datum/unit_test/medical_brain_healing/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 20)
	patient.adjust_phantom_brain_damage(40)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, -30)
	TEST_ASSERT_EQUAL(brain.damage, 30, "Brain medical invariant failed")
	TEST_ASSERT_EQUAL(brain.phantom_damage, 10, "Brain medical invariant failed")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 10)
	TEST_ASSERT_EQUAL(brain.damage, 10, "Brain medical invariant failed")
	TEST_ASSERT_EQUAL(brain.phantom_damage, 0, "Brain medical invariant failed")
	ADD_TRAIT(patient, TRAIT_GODMODE, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_phantom_brain_damage(50)
	TEST_ASSERT_EQUAL(brain.damage, 10, "Moon damage bypassed godmode")

/// A tie is phantom death; ordinary treatment restores function without spending capacity.
/datum/unit_test/medical_brain_phantom_death/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 100)
	patient.adjust_phantom_brain_damage(100)
	TEST_ASSERT(brain.phantom_death, "Equal pools must classify as phantom death")
	TEST_ASSERT_EQUAL(brain.maxHealth, 200, "Brain medical invariant failed")
	brain.on_life(0)
	TEST_ASSERT_EQUAL(patient.stat, DEAD, "Brain medical invariant failed")
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, -150)
	TEST_ASSERT_EQUAL(brain.damage, 50, "Brain medical invariant failed")
	TEST_ASSERT_EQUAL(brain.phantom_damage, 0, "Brain medical invariant failed")
	TEST_ASSERT(patient.revive(), "Healed phantom death could not be revived")
	TEST_ASSERT_EQUAL(brain.maxHealth, 200, "Brain medical invariant failed")
	TEST_ASSERT(brain.destruction_armed, "Phantom death spent the real destruction latch")

/// Real destruction is charged at damage time, once per recovered episode, and exhausts on the fourth death.
/datum/unit_test/medical_brain_destruction/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/hemostat/tool = allocate(/obj/item/hemostat)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	var/datum/surgery_operation/organ/repair/brain/reconstruction/surgery = GLOB.operations.operations_by_typepath[__IMPLIED_TYPE__]
	for(var/expected_capacity in list(150, 100, 50))
		patient.set_organ_loss(ORGAN_SLOT_BRAIN, brain.maxHealth)
		TEST_ASSERT_EQUAL(brain.maxHealth, expected_capacity, "Destruction must be charged before surgery")
		brain.on_life(0)
		TEST_ASSERT_EQUAL(patient.stat, DEAD, "Brain medical invariant failed")
		patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, -5)
		TEST_ASSERT_EQUAL(brain.damage, expected_capacity + 45, "A small heal must work above the new cap without discarding damage")
		TEST_ASSERT(!patient.revive(), "Real destruction bypassed reconstruction")
		UNLINT(surgery.success(brain, surgeon, tool, list()))
		TEST_ASSERT_EQUAL(brain.maxHealth, expected_capacity, "Surgery charged for the same destruction twice")
		patient.set_organ_loss(ORGAN_SLOT_BRAIN, 0)
		TEST_ASSERT(patient.revive(), "Brain medical invariant failed")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, brain.maxHealth)
	TEST_ASSERT_EQUAL(brain.maxHealth, 0, "Brain medical invariant failed")
	brain.on_life(0)
	TEST_ASSERT(!brain.reconstruct_brain(), "Exhausted brain still allowed reconstruction")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 0)
	TEST_ASSERT(!patient.revive(), "Ordinary healing revived an exhausted brain")

/// Early partial revival does not spend another life; two minutes alive re-arms the cost.
/datum/unit_test/medical_brain_recovery_window/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 200)
	brain.on_life(0)
	TEST_ASSERT(brain.reconstruct_brain(), "Brain medical invariant failed")
	TEST_ASSERT(patient.revive(), "Brain medical invariant failed")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 150)
	TEST_ASSERT_EQUAL(brain.maxHealth, 150, "Early second death spent another recovery")
	brain.on_life(0)
	TEST_ASSERT(brain.reconstruct_brain(), "Brain medical invariant failed")
	TEST_ASSERT(patient.revive(), "Brain medical invariant failed")
	// Age the recorded revival rather than waiting two real minutes in the test runner.
	brain.recovery_started = world.time - (2 MINUTES + 1)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 1)
	TEST_ASSERT(brain.destruction_armed, "Brain medical invariant failed")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 150)
	TEST_ASSERT_EQUAL(brain.maxHealth, 100, "Brain medical invariant failed")

/// Regeneration/species replacement must not turn phantom damage into real destruction.
/datum/unit_test/medical_brain_replacement/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	var/obj/item/organ/brain/replacement = allocate(/obj/item/organ/brain)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 90)
	patient.adjust_phantom_brain_damage(110)
	brain.before_organ_replacement(replacement)
	TEST_ASSERT_EQUAL(replacement.maxHealth, 200, "Brain medical invariant failed")
	TEST_ASSERT_EQUAL(replacement.phantom_damage, 110, "Brain medical invariant failed")
	TEST_ASSERT_EQUAL(replacement.damage, 200, "Brain medical invariant failed")
	TEST_ASSERT(!replacement.requires_reconstruction, "Brain medical invariant failed")

/// Real damage predominance must charge capacity even when the final hit is phantom.
/datum/unit_test/medical_brain_real_predominance/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 110)
	patient.adjust_phantom_brain_damage(90)
	TEST_ASSERT(!brain.phantom_death, "The final source incorrectly overrode real damage predominance")
	TEST_ASSERT(brain.requires_reconstruction, "Real destruction did not require reconstruction")
	TEST_ASSERT_EQUAL(brain.maxHealth, 150, "Real-dominant mixed death did not charge capacity")

/// An actual robe conversion and delayed death must preserve the patient's head and recovery budget.
/datum/unit_test/medical_moon_robe/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.set_hud_used(allocate(/datum/hud/human, patient))
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	var/obj/item/clothing/suit/hooded/cultrobes/eldritch/moon/robe = allocate(/obj/item/clothing/suit/hooded/cultrobes/eldritch/moon)
	TEST_ASSERT(patient.equip_to_slot_if_possible(robe, ITEM_SLOT_OCLOTHING), "Could not equip the Moon robe")
	patient.adjust_brute_loss(200)
	TEST_ASSERT_EQUAL(brain.phantom_damage, 200, "Robe conversion produced real brain damage")
	TEST_ASSERT_EQUAL(patient.get_brute_loss(), 0, "Robe failed to intercept the original damage")
	// The robe schedules death after five seconds; allow one additional second for subsystem ordering.
	sleep(6 SECONDS)
	TEST_ASSERT_EQUAL(patient.stat, DEAD, "Robe's delayed death did not occur")
	TEST_ASSERT_NOTNULL(patient.get_bodypart(BODY_ZONE_HEAD), "Phantom death destroyed the head")
	TEST_ASSERT_EQUAL(brain.maxHealth, 200, "Robe's death handler spent a real recovery")
	patient.set_organ_loss(ORGAN_SLOT_BRAIN, 0)
	TEST_ASSERT(patient.revive(), "Could not revive the robe wearer after treating phantom damage")
	patient.adjust_brute_loss(200)
	sleep(6 SECONDS)
	TEST_ASSERT_EQUAL(patient.stat, DEAD, "Robe failed to handle a second phantom death")
	TEST_ASSERT_NOTNULL(patient.get_bodypart(BODY_ZONE_HEAD), "Second phantom death destroyed the head")
	TEST_ASSERT_EQUAL(brain.maxHealth, 200, "Second phantom death spent a real recovery")

/// Pure neurine's delayed rollback is still ordinary healing, consuming phantom damage first.
/datum/unit_test/medical_neurine_rollback/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	ADD_TRAIT(brain, TRAIT_BRAIN_TRAUMA_IMMUNITY, TRAIT_SOURCE_UNIT_TESTS)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 20)
	patient.reagents.add_reagent(/datum/reagent/medicine/neurine, 5, added_purity = 1)
	patient.adjust_phantom_brain_damage(30)
	patient.adjust_organ_loss(ORGAN_SLOT_BRAIN, 10)
	patient.reagents.remove_reagent(/datum/reagent/medicine/neurine, 5)
	TEST_ASSERT_EQUAL(brain.damage, 20, "Pure neurine did not restore the captured damage level")
	TEST_ASSERT_EQUAL(brain.phantom_damage, 0, "Neurine's rollback did not heal phantom damage first")
	TEST_ASSERT_EQUAL(brain.maxHealth, 200, "Neurine's rollback changed brain capacity")

