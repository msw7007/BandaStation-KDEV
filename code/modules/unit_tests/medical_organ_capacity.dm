/// Repeated repair charges the current maximum and a new donor organ cannot erase the recipient's wear.
/datum/unit_test/medical_organ_capacity/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/surgeon = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/scalpel/tool = allocate(/obj/item/scalpel)
	var/obj/item/organ/liver/liver = patient.get_organ_slot(ORGAN_SLOT_LIVER)
	var/datum/surgery_operation/organ/repair/hepatectomy/surgery = GLOB.operations.operations_by_typepath[__IMPLIED_TYPE__]
	liver.set_organ_damage(70)
	UNLINT(surgery.success(liver, surgeon, tool, list()))
	TEST_ASSERT_EQUAL(liver.maxHealth, 90, "First repair did not charge ten percent")
	liver.set_organ_damage(70)
	UNLINT(surgery.success(liver, surgeon, tool, list()))
	// DM uses single-precision floats; fractional wear is checked well below one damage unit.
	TEST_ASSERT(abs(liver.maxHealth - 81) < 0.001, "Second repair used the original maximum")
	liver.Remove(patient, special = TRUE)
	var/obj/item/organ/liver/replacement = allocate(/obj/item/organ/liver)
	replacement.Insert(patient, special = TRUE)
	TEST_ASSERT(abs(replacement.maxHealth - 81) < 0.001, "Transplant erased surgical wear")
	TEST_ASSERT_EQUAL(replacement.damage, 0, "A healthy worn organ gained damage merely from implantation")
	TEST_ASSERT(!(replacement.organ_flags & ORGAN_FAILING), "A healthy worn organ should function")
	replacement.Remove(patient, special = TRUE)
	// Damage which was tolerable in the donor may exceed the recipient's inherited capacity.
	var/obj/item/organ/liver/damaged_donor = allocate(/obj/item/organ/liver)
	damaged_donor.set_organ_damage(85)
	damaged_donor.Insert(patient, special = TRUE)
	TEST_ASSERT(damaged_donor.organ_flags & ORGAN_FAILING, "Inherited capacity below donor damage did not cause organ failure")
	damaged_donor.set_medical_capacity(1)
	TEST_ASSERT(!(damaged_donor.organ_flags & ORGAN_FAILING), "Restored capacity did not clear organ failure")
	damaged_donor.Remove(patient, special = TRUE)
	var/obj/item/organ/liver/healed_replacement = allocate(/obj/item/organ/liver)
	healed_replacement.Insert(patient, special = TRUE)
	TEST_ASSERT_EQUAL(healed_replacement.maxHealth, 100, "Replacement resurrected wear after capacity restoration")

/// Scarring and surgical wear must compose without negative capacity or a free capacity reset.
/datum/unit_test/medical_eye_capacity/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/eyes/eyes = patient.get_organ_slot(ORGAN_SLOT_EYES)
	eyes.set_medical_capacity(0.4)
	eyes.apply_scar(LEFT_EYE_SCAR)
	eyes.apply_scar(RIGHT_EYE_SCAR)
	TEST_ASSERT(abs(eyes.maxHealth - 8) < 0.001, "Eye scars did not account for surgical wear")
	eyes.set_medical_capacity(1)
	TEST_ASSERT(abs(eyes.maxHealth - 20) < 0.001, "Restoring capacity erased scarring")
	eyes.fix_scar(LEFT_EYE_SCAR)
	eyes.fix_scar(RIGHT_EYE_SCAR)
	TEST_ASSERT(abs(eyes.maxHealth - 50) < 0.001, "Scar treatment restored the wrong eye capacity")

/// Cryoxadone alone and cold treatment outside a cell cannot restore capacity; the matching combination can.
/datum/unit_test/medical_cryo_capacity/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/liver/liver = patient.get_organ_slot(ORGAN_SLOT_LIVER)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	var/obj/machinery/cryo_cell/cell = allocate(/obj/machinery/cryo_cell)
	liver.set_medical_capacity(0.8)
	brain.set_brain_max_health(150)
	patient.bodytemperature = 250
	patient.reagents.add_reagent(/datum/reagent/medicine/cryoxadone, 10)
	var/datum/reagent/medicine/cryoxadone/cryo = patient.reagents.has_reagent(/datum/reagent/medicine/cryoxadone)
	cryo.on_mob_life(patient, 2, 1)
	TEST_ASSERT_EQUAL(liver.maxHealth, 80, "Cryoxadone outside a chamber restored capacity")
	patient.forceMove(cell)
	cell.set_occupant(patient)
	UNLINT(cell.set_on(TRUE))
	cryo.on_mob_life(patient, 2, 1)
	TEST_ASSERT_EQUAL(liver.maxHealth, 80, "Cryoxadone alone restored capacity")
	patient.reagents.add_reagent(/datum/reagent/medicine/higadrite, 10)
	TEST_ASSERT(cell.has_organ_capacity_treatment(), "Fully healed patient would be ejected before wear treatment")
	cryo.on_mob_life(patient, 2, 1)
	TEST_ASSERT(liver.maxHealth > 80 && liver.maxHealth < 100, "Combined treatment did not gradually restore capacity")
	TEST_ASSERT_EQUAL(brain.maxHealth, 150, "Cryotherapy restored forbidden brain capacity")
	UNLINT(cell.set_on(FALSE))
	var/stopped_capacity = liver.maxHealth
	cryo.on_mob_life(patient, 2, 1)
	TEST_ASSERT_EQUAL(liver.maxHealth, stopped_capacity, "An inactive chamber kept restoring capacity")

/// Cryoneurine changes resilience, preserves symptoms until cured, and cannot bypass stronger trauma tiers.
/datum/unit_test/medical_cryoneurine/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/machinery/cryo_cell/cell = allocate(/obj/machinery/cryo_cell)
	cell.set_occupant(patient)
	var/obj/item/organ/brain/brain = patient.get_organ_slot(ORGAN_SLOT_BRAIN)
	brain.set_brain_max_health(150)
	var/datum/brain_trauma/trauma = brain.gain_trauma(/datum/brain_trauma/severe/mute)
	patient.reagents.add_reagent(/datum/reagent/medicine/cryoneurine, 10)
	var/datum/reagent/medicine/cryoneurine/medicine = patient.reagents.has_reagent(/datum/reagent/medicine/cryoneurine)
	TEST_ASSERT(cell.has_cryoneurine_treatment(), "Cryo would eject a patient with a treatable trauma")
	medicine.on_mob_life(patient, 20, 1)
	TEST_ASSERT_EQUAL(trauma.resilience, TRAUMA_RESILIENCE_SURGERY, "Warm cryoneurine treated a trauma")
	patient.bodytemperature = 250
	medicine.on_mob_life(patient, 20, 1)
	TEST_ASSERT_EQUAL(trauma.resilience, TRAUMA_RESILIENCE_BASIC, "Severe did not become Mild")
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_MUTE), "Reducing resilience removed the trauma's symptoms")
	medicine.on_mob_life(patient, 20, 1)
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_MUTE), "Curing Mild left its symptoms behind")
	TEST_ASSERT(!cell.has_cryoneurine_treatment(), "Cryo continued treatment after curing all traumas")
	TEST_ASSERT_EQUAL(brain.maxHealth, 150, "Trauma treatment restored brain capacity")
	for(var/resilience in list(TRAUMA_RESILIENCE_LOBOTOMY, TRAUMA_RESILIENCE_WOUND, TRAUMA_RESILIENCE_MAGIC, TRAUMA_RESILIENCE_ABSOLUTE))
		trauma = brain.gain_trauma(/datum/brain_trauma/severe/mute, resilience)
		medicine.on_mob_life(patient, 20, 1)
		TEST_ASSERT_EQUAL(trauma.resilience, resilience, "Cryoneurine bypassed an excluded trauma tier")
		TEST_ASSERT(!cell.has_cryoneurine_treatment(), "An untreatable trauma kept cryo running")
		qdel(trauma)

