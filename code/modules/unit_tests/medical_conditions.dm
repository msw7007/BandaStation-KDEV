/// Numb hides perception, while unchanged pain and capped pain never roll again.
/datum/unit_test/medical_pain_events/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.add_traits(list(TRAIT_ANALGESIA, TRAIT_PAIN_NUMB), QUIRK_TRAIT)
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_L_ARM)
	var/datum/component/medical_condition/condition = arm.get_medical_condition()
	condition.add_pain(100)
	TEST_ASSERT_EQUAL(condition.pain, 100, "Numb suppressed the pain accumulator")
	TEST_ASSERT_EQUAL(condition.pain_rolls, 1, "Positive pain did not perform exactly one check")
	condition.process(10)
	TEST_ASSERT_EQUAL(condition.pain_rolls, 1, "Stable pain rerolled during processing")
	condition.add_pain(0)
	TEST_ASSERT_EQUAL(condition.pain_rolls, 1, "Zero damage rerolled pain")
	condition.pain = 300
	condition.add_pain(10)
	TEST_ASSERT_EQUAL(condition.pain_rolls, 1, "A capped accumulator rerolled without increasing")
	patient.apply_status_effect(/datum/status_effect/medical_pain)
	patient.apply_status_effect(/datum/status_effect/medical_pain)
	TEST_ASSERT(patient.has_status_effect(/datum/status_effect/medical_pain), "Pain penalty missing")
	patient.remove_status_effect(/datum/status_effect/medical_pain)
	TEST_ASSERT(!patient.has_status_effect(/datum/status_effect/medical_pain), "Pain penalty failed to clean up")

/datum/unit_test/medical_analgesia_routes/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.reagents.add_reagent(/datum/reagent/medicine/morphine, 10)
	var/datum/reagent/medicine/morphine/morphine = patient.reagents.has_reagent(/datum/reagent/medicine/morphine)
	patient.medical_exposure_zone = BODY_ZONE_L_ARM
	patient.medical_exposure(morphine, PATCH, 10, 0)
	TEST_ASSERT(abs(patient.medical_analgesia(BODY_ZONE_L_ARM) - 0.45) < 0.001, "Topical analgesia did not use 90% of ordinary strength")
	TEST_ASSERT_EQUAL(patient.medical_analgesia(BODY_ZONE_R_ARM), 0, "Topical medicine leaked into systemic analgesia")
	patient.medical_exposure(morphine, INGEST, 10, 0)
	TEST_ASSERT(abs(patient.medical_analgesia(BODY_ZONE_R_ARM) - 0.25) < 0.001, "Oral medicine did not use half strength")
	TEST_ASSERT(abs(patient.medical_analgesia(BODY_ZONE_L_ARM) - 0.45) < 0.001, "Two routes stacked instead of selecting their maximum")
	patient.medical_exposure(morphine, INJECT, 10, 0)
	TEST_ASSERT_EQUAL(patient.medical_analgesia(BODY_ZONE_L_ARM), 0.5, "Injected ordinary painkiller did not retain full source strength")
	patient.add_traits(list(TRAIT_ANALGESIA, TRAIT_PAIN_NUMB), QUIRK_TRAIT)
	TEST_ASSERT_EQUAL(patient.medical_analgesia(BODY_ZONE_HEAD), 0.5, "Numb overrode genuine medication")

/datum/unit_test/medical_contamination/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_L_ARM)
	var/datum/component/medical_condition/condition = arm.get_medical_condition()
	condition.add_contamination(95)
	TEST_ASSERT_EQUAL(condition.infection_stage(), 0, "Infection started before 100 exposure")
	condition.add_contamination(5)
	TEST_ASSERT_EQUAL(condition.infection_stage(), 1, "Threshold did not start infection")
	condition.sterilize(1)
	TEST_ASSERT_EQUAL(condition.contamination, 0, "Sterilizine left contamination behind")
	condition.add_contamination(100)
	TEST_ASSERT_EQUAL(condition.contamination, 0, "Antiseptic window did not protect tissue")
	condition.antiseptic_seconds = 0
	condition.infection_seconds = 1200
	condition.process(1)
	TEST_ASSERT(HAS_TRAIT(arm, TRAIT_PARALYSIS), "Critical infection did not disable the limb")
	condition.treat_infection(1200)
	TEST_ASSERT_EQUAL(condition.infection_stage(), 4, "Ordinary medicine bypassed necrosis surgery")
	condition.treat_infection(INFINITY, critical = TRUE)
	TEST_ASSERT(!HAS_TRAIT(arm, TRAIT_PARALYSIS), "Necrosis treatment left paralysis behind")

/datum/unit_test/medical_fracture_floor/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/chest = patient.get_bodypart(BODY_ZONE_CHEST)
	chest.force_wound_upwards(/datum/wound/blunt/bone/severe)
	TEST_ASSERT(chest.medical_fracture(), "Test setup did not produce a fracture")
	patient.reagents.clear_reagents()
	patient.medical_adrenaline_until = 0
	TEST_ASSERT_EQUAL(patient.medical_analgesia(BODY_ZONE_CHEST), 0, "Test setup retained analgesia")
	var/datum/component/medical_condition/condition = chest.get_medical_condition()
	condition.pain = 100
	condition.process(1000)
	TEST_ASSERT(condition.pain >= 25, "Existing fracture lost its constant pain floor")
	TEST_ASSERT_EQUAL(condition.pain_rolls, 0, "Fracture floor generated repeated pain checks")

/datum/unit_test/medical_no_fracture_organs/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/chest = patient.get_bodypart(BODY_ZONE_CHEST)
	for(var/index in 1 to 20)
		chest.medical_hit(20, 0, SHARP_POINTY, FALSE, TRUE)
	for(var/obj/item/organ/organ as anything in patient.organs)
		TEST_ASSERT_EQUAL(organ.damage, 0, "Piercing an unfractured limb damaged an internal organ")
		var/datum/component/medical_condition/condition = organ.get_medical_condition(FALSE)
		TEST_ASSERT(!condition?.organ_bleeding, "Organ bleeding started without a fracture")

/datum/unit_test/medical_stasis_composition/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.apply_status_effect(/datum/status_effect/grouped/medical_stasis, "bed")
	TEST_ASSERT_EQUAL(patient.medical_time_scale(), 0.5, "Bed did not slow biological time by half")
	patient.apply_status_effect(/datum/status_effect/grouped/medical_stasis/cryostasis, "bag")
	TEST_ASSERT_EQUAL(patient.medical_time_scale(), 0.25, "Stasis factors multiplied rather than choosing the strongest")
	patient.remove_status_effect(/datum/status_effect/grouped/medical_stasis/cryostasis, "bag")
	TEST_ASSERT_EQUAL(patient.medical_time_scale(), 0.5, "Removing bag also removed bed slowdown")
	patient.remove_status_effect(/datum/status_effect/grouped/medical_stasis, "bed")
	TEST_ASSERT_EQUAL(patient.medical_time_scale(), 1, "Stasis cleanup left biological slowdown")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_HANDS_BLOCKED), "Stasis cleanup left hands blocked")

/datum/unit_test/medical_cpr_windows/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.set_body_position(LYING_DOWN)
	patient.adjust_oxy_loss(20)
	TEST_ASSERT(patient.apply_medical_cpr(), "CPR refused an oxygen-starved lying patient")
	var/window = patient.medical_cpr_protection_until
	patient.apply_medical_cpr(trained = TRUE)
	TEST_ASSERT_EQUAL(patient.medical_cpr_protection_until, window, "Second rescuer extended an active organ protection window")
	patient.apply_medical_cpr()
	TEST_ASSERT(patient.medical_cpr_errors > 0, "Rapid untrained CPR did not accumulate errors")
	patient.set_body_position(STANDING_UP)
	TEST_ASSERT(!patient.apply_medical_cpr(), "CPR operated on a standing patient")

/datum/unit_test/medical_infusion_combat/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/reagent_containers/blood/bag = allocate(/obj/item/reagent_containers/blood)
	bag.forceMove(get_turf(patient))
	bag.medical_patient = WEAKREF(patient)
	bag.medical_sealed = FALSE
	patient.set_body_position(LYING_DOWN)
	bag.reagents.add_reagent(/datum/reagent/water, 10)
	bag.process(1)
	TEST_ASSERT(!bag.medical_draw, "Resting patient was forced into withdrawal")
	patient.medical_combat_until = world.time + 10 SECONDS
	bag.process(1)
	TEST_ASSERT(bag.medical_draw, "Lying fighter retained infusion")
	bag.medical_draw = FALSE
	bag.process(1)
	TEST_ASSERT(bag.medical_draw, "Manual mode change bypassed combat restriction")
	bag.forceMove(patient)
	bag.process(1)
	TEST_ASSERT_NULL(bag.medical_patient, "Pocketed bag retained a live connection")

/datum/unit_test/medical_fractional_supplies/Run()
	var/obj/item/stack/medical/suture/supplies = allocate(/obj/item/stack/medical/suture, null, 1, FALSE)
	for(var/index in 1 to 9)
		TEST_ASSERT(supplies.use(0.1), "Surgical tenth was unavailable")
	TEST_ASSERT(!QDELETED(supplies), "Fractional stack was deleted before all ten uses")
	TEST_ASSERT(abs(supplies.amount - 0.1) < 0.001, "Fractional surgery lost material accounting")
	TEST_ASSERT(supplies.use(0.1), "Last surgical tenth was unavailable")
	TEST_ASSERT(QDELETED(supplies), "Empty fractional stack survived")

/datum/unit_test/medical_anesthesia_cleanup/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.apply_status_effect(/datum/status_effect/grouped/medical_anesthesia, "nerv")
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_KNOCKEDOUT), "NERV did not anesthetize the patient")
	TEST_ASSERT_EQUAL(patient.medical_analgesia(BODY_ZONE_HEAD), 1, "NERV did not provide true analgesia")
	patient.remove_status_effect(/datum/status_effect/grouped/medical_anesthesia, "nerv")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_MEDICAL_ANESTHESIA), "NERV left anesthesia after shutdown")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_KNOCKEDOUT), "NERV left knockout after shutdown")

/datum/unit_test/medical_stasis_metabolism/Run()
	var/mob/living/carbon/human/normal = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/slowed = allocate(/mob/living/carbon/human/consistent)
	normal.adjust_brute_loss(20)
	slowed.adjust_brute_loss(20)
	normal.reagents.add_reagent(/datum/reagent/medicine/c2/libital, 10)
	slowed.reagents.add_reagent(/datum/reagent/medicine/c2/libital, 10)
	slowed.apply_status_effect(/datum/status_effect/grouped/medical_stasis, "test")
	normal.reagents.metabolize(normal, 2)
	slowed.reagents.metabolize(slowed, 2 * slowed.medical_time_scale())
	var/normal_healing = 20 - normal.get_brute_loss()
	var/slow_healing = 20 - slowed.get_brute_loss()
	TEST_ASSERT(normal_healing > 0, "Test medicine did not heal")
	TEST_ASSERT(abs(slow_healing * 2 - normal_healing) < 0.001, "Stasis did not halve drug effects exactly once")
	var/normal_used = 10 - normal.reagents.get_reagent_amount(/datum/reagent/medicine/c2/libital)
	var/slow_used = 10 - slowed.reagents.get_reagent_amount(/datum/reagent/medicine/c2/libital)
	TEST_ASSERT(abs(slow_used * 2 - normal_used) < 0.001, "Stasis did not halve drug consumption")
	var/datum/reagent/normal_drug = normal.reagents.has_reagent(/datum/reagent/medicine/c2/libital)
	var/datum/reagent/slow_drug = slowed.reagents.has_reagent(/datum/reagent/medicine/c2/libital)
	TEST_ASSERT_EQUAL(slow_drug.current_cycle * 2, normal_drug.current_cycle, "Drug progression ignored biological time")

/// Cardiac arrest is supported without healing the heart or masking independent hypoxia.
/datum/unit_test/medical_compressor_lifecycle/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/suit/autocompressor/compressor = allocate(/obj/item/clothing/suit/autocompressor)
	TEST_ASSERT(patient.equip_to_slot_if_possible(compressor, ITEM_SLOT_OCLOTHING), "Compressor could not be worn")
	patient.set_heartattack(TRUE)
	compressor.attack_self(patient)
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_CARDIAC_SUPPORT), "Powered worn compressor did not support arrest")
	patient.handle_heart(1)
	TEST_ASSERT_EQUAL(patient.get_oxy_loss(), 0, "Arrest still suffocated a supported patient")
	TEST_ASSERT(patient.undergoing_cardiac_arrest(), "Compressor restarted the heart")
	patient.adjust_oxy_loss(10)
	compressor.process(1)
	TEST_ASSERT_EQUAL(patient.get_oxy_loss(), 10, "Support erased independent oxygen damage")
	compressor.cell.charge = 0
	compressor.process(1)
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_CARDIAC_SUPPORT), "Empty battery retained cardiac support")
	patient.handle_heart(1)
	TEST_ASSERT(patient.get_oxy_loss() > 10, "Arrest failed to resume suffocation after battery depletion")
	compressor.cell.give(100)
	compressor.attack_self(patient)
	compressor.attack_self(patient)
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_CARDIAC_SUPPORT), "Recharged device could not restart")
	patient.dropItemToGround(compressor, force = TRUE)
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_CARDIAC_SUPPORT), "Removed compressor retained cardiac support")

/// The real table/console boundary must deliver researched operations and release anesthesia.
/datum/unit_test/medical_nerv_lifecycle/Run()
	var/obj/machinery/stasis/medical_station/nerv/table = allocate(/obj/machinery/stasis/medical_station/nerv, run_loc_floor_bottom_left)
	var/obj/machinery/computer/operating/computer = allocate(/obj/machinery/computer/operating, get_step(table, NORTH))
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent, get_turf(table))
	TEST_ASSERT_EQUAL(computer.nerv_table, table, "Operating console did not discover NERV")
	TEST_ASSERT_EQUAL(table.computer, computer, "NERV link was not bidirectional")
	TEST_ASSERT(table.buckle_mob(patient, force = TRUE), "NERV could not buckle patient")
	table.stasis_enabled = TRUE
	table.set_is_operational(TRUE)
	table.process(1)
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_MEDICAL_ANESTHESIA), "NERV did not anesthetize its occupant")
	computer.set_is_operational(TRUE)
	computer.advanced_surgeries |= /datum/surgery_operation/limb/close_skin/abductor
	var/list/operations = list()
	SEND_SIGNAL(patient, COMSIG_ATOM_BEING_OPERATED_ON, patient, operations)
	TEST_ASSERT(/datum/surgery_operation/limb/close_skin/abductor in operations, "NERV failed to expose researched operations")
	table.set_is_operational(FALSE)
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_MEDICAL_ANESTHESIA), "NERV retained anesthesia without power")
	table.set_is_operational(TRUE)
	table.process(1)
	table.unbuckle_mob(patient, force = TRUE)
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_MEDICAL_ANESTHESIA), "NERV retained anesthesia after unbuckling")
	operations.Cut()
	SEND_SIGNAL(patient, COMSIG_ATOM_BEING_OPERATED_ON, patient, operations)
	TEST_ASSERT(!length(operations), "NERV surgery link survived patient removal")

/// Cold alone cannot close a severe puncture, and sutures cannot cure a bruise.
/datum/unit_test/medical_severe_puncture/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = patient.get_bodypart(BODY_ZONE_L_ARM)
	var/datum/wound/pierce/bleed/severe/wound = arm.force_wound_upwards(/datum/wound/pierce/bleed/severe)
	TEST_ASSERT(istype(wound), "Test puncture was not applied")
	patient.bodytemperature = 250
	var/original_flow = wound.blood_flow
	wound.handle_process(30)
	TEST_ASSERT(!QDELETED(wound), "Cold deleted a severe puncture")
	TEST_ASSERT_EQUAL(wound.blood_flow, original_flow, "Untreated severe puncture healed naturally")
	var/datum/component/medical_condition/condition = arm.get_medical_condition()
	condition.add_minor(WOUND_BLUNT)
	condition.add_minor(WOUND_SLASH)
	condition.treat_minor(TRUE, FALSE, bruises = FALSE)
	TEST_ASSERT(LAZYACCESS(condition.minor_wounds, WOUND_BLUNT), "Suture treatment healed a bruise")
	TEST_ASSERT(!LAZYACCESS(condition.minor_wounds, WOUND_SLASH), "Suture treatment failed to heal a cut")


/// Use the real breath signal and species lungs; replacing a tank must change the supplied gas.
/datum/unit_test/medical_compressor_gases/Run()
	var/mob/living/carbon/human/species/plasma/patient = allocate(/mob/living/carbon/human/species/plasma)
	var/obj/item/clothing/suit/autocompressor/compressor = allocate(/obj/item/clothing/suit/autocompressor)
	TEST_ASSERT(patient.equip_to_slot_if_possible(compressor, ITEM_SLOT_OCLOTHING), "Compressor could not be worn by plasmaman")
	compressor.tank = allocate(/obj/item/tank/internals/emergency_oxygen, compressor)
	compressor.attack_self(patient)
	patient.breathe()
	TEST_ASSERT(patient.failed_last_breath, "Wrong gas sustained plasmaman breathing")
	compressor.attack_self(patient)
	var/obj/item/tank/internals/plasmaman/replacement = allocate(/obj/item/tank/internals/plasmaman)
	patient.put_in_active_hand(replacement)
	TEST_ASSERT_EQUAL(compressor.item_interaction(patient, replacement, list()), ITEM_INTERACT_SUCCESS, "Compressor rejected a species-compatible replacement tank")
	compressor.attack_self(patient)
	var/gas_before = replacement.air_contents.total_moles()
	patient.breathe()
	TEST_ASSERT(!patient.failed_last_breath, "Species-compatible gas failed through compressor")
	TEST_ASSERT(replacement.air_contents.total_moles() < gas_before, "Breathing did not consume the installed tank")

/// Choosing ABO must not overwrite a nonhuman blood type or fix the Rh sign.
/datum/unit_test/medical_blood_preference/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	var/datum/preference/choiced/medical_blood_group/preference = GLOB.preference_entries[/datum/preference/choiced/medical_blood_group]
	TEST_ASSERT(preference.is_valid("AB"), "Blood preference rejected a supported ABO group")
	TEST_ASSERT(!preference.is_valid("C"), "Blood preference accepted an invalid group")
	preference.apply_to_human(patient, "AB")
	TEST_ASSERT(patient.get_bloodtype().type in list(/datum/blood_type/human/ab_plus, /datum/blood_type/human/ab_minus), "AB preference did not retain an independent Rh choice")
	var/datum/blood_type/selected = patient.get_bloodtype()
	preference.apply_to_human(patient, "Случайная")
	TEST_ASSERT_EQUAL(patient.get_bloodtype(), selected, "Default preference overwrote the species-generated group")
	patient.set_blood_type(/datum/blood_type/slime)
	selected = patient.get_bloodtype()
	preference.apply_to_human(patient, "O")
	TEST_ASSERT_EQUAL(patient.get_bloodtype(), selected, "Human blood preference overwrote nonhuman blood")
